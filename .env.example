# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Which AI to use: spark (default), openai, or anthropic
LLM_PROVIDER=spark

# DGX Spark gateway (OpenAI-compatible format)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# OpenAI (ChatGPT)
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Canvas LMS (Account > Settings > New Access Token)
CANVAS_BASE_URL=https://yourschool.instructure.com/api/v1
CANVAS_API_TOKEN=

# MongoDB storage
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=

# API server port (Vite proxies /api here)
PORT=3001
